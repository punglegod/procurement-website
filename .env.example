# 凭据仅存服务器侧；卓创后台加密配置优先，清除后回落此文件。不要提交真实值。
SCI99_USER=
SCI99_PASS=
# 遇验证码时请在官网人工登录，将本人账号的有效登录态填到这里。
SCI99_COOKIE=
# ABS 试点使用含完整报价日期和现货均价表格的本人已订阅页面。
# 默认产品页可能动态加载或要求登录，无法解析时接口如实报告。
SCI99_ABS_URL=https://ochem.sci99.com/product/abs
# 可选：官网提供普通 HTML 登录表单时填写；当前 JS/验证码登录请用 COOKIE。
SCI99_LOGIN_URL=https://ucenter.sci99.com/

# Telegram 推送：在根目录 .env 填写；留空时页面和接口显示「待配置」。
# 向 @BotFather 创建 Bot 获取 token；先向 Bot 发 /start，再填写本人会话 chat_id。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 仅系统没有任何管理员时播种；至少 8 位密码，已有管理员不会因本配置更名。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 个人邮件推送；留空时如实记录待配置。
RESEND_API_KEY=
EMAIL_FROM=sourcing@bbbhl.com
# 默认 true；仅本地 HTTP 开发时显式设为 false。
SESSION_COOKIE_SECURE=true
# 公开站点来源（仅协议、域名、可选端口）；HTTPS 入口应显式填写，本地可留空
PUBLIC_BASE_URL=
# 后台卓创凭据的Fernet加密密钥；由运维离线生成和保管，缺失时禁止保存凭据。
SETTINGS_ENCRYPTION_KEY=
